# Copier en .env pour le développement local. Ne jamais committer .env.
# Base locale : docker compose up -d (voir docker-compose.yml à la racine)
DATABASE_URL=postgresql://notes:notes@localhost:5432/notes

# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=remplacez-moi-par-une-valeur-aleatoire-de-48-caracteres
JWT_EXPIRE_MINUTES=60

# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# Seulement pour seed.py
SEED_EMAIL=demo@example.com
SEED_PASSWORD=
